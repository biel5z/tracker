# Copie este arquivo para ".env" (na mesma pasta) e cole o seu token do TMDB.
# Onde pegar: https://www.themoviedb.org/settings/api  →  "API Read Access Token" (o token longo, não a "API Key").
TMDB_TOKEN=cole_seu_token_aqui

# Porta do BFF (o Vite encaminha /api para cá)
PORT=3333

# Idioma e região usados nas consultas ao TMDB
TMDB_LANGUAGE=pt-BR
TMDB_REGION=BR

# true = usa dados falsos, sem chamar o TMDB (útil para testar sem token)
TMDB_MOCK=false
